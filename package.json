{
	"name": "peers-app",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev --workspaces --if-present",
		"dev:server": "npm run dev -w @peers/server",
		"dev:client": "npm run dev -w @peers/client",
		"dev:marketing": "npm run dev -w @peers/marketing",
		"docker:up": "docker compose up --build -d",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f server",
		"deploy": "npm run deploy -w @peers/server",
		"deploy:prod": "npm run deploy:prod -w @peers/server",
		"deploy:vercel": "cd packages/client && vercel --prod && cd ../marketing && vercel --prod",
		"deploy:client": "cd packages/client && vercel --prod",
		"deploy:marketing": "cd packages/marketing && vercel --prod",
		"build": "npm run build -w @peers/client",
		"build:marketing": "npm run build -w @peers/marketing",
		"build:all": "npm run build && npm run build:marketing",
		"test": "npm run test -w @peers/server",
		"start": "npm run start -w @peers/server",
		"start:marketing": "npm run start -w @peers/marketing",
		"prod": "npm run build && USE_HTTP=true npm run start",
		"install:all": "npm install"
	},
	"devDependencies": {
		"concurrently": "^9.1.0"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1"
	}
}
