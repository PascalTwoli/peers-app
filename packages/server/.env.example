# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV="development"
HOST="0.0.0.0"
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Neon / Railway PostgreSQL connection string
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for fully open (dev only).
CORS_ORIGINS="http://localhost:5173,https://app.yourdomain.com"

# ─── AWS S3 (file uploads) ────────────────────────────────────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_BUCKET_NAME="your-s3-bucket-name"

# Alternative aliases (also supported)
S3_ACCESS_KEY="your-access-key-id"
S3_SECRET_KEY="your-secret-access-key"

# ─── Tuning (optional) ────────────────────────────────────────────────────────
# Maximum simultaneous WebSocket connections per IP address
MAX_CONNECTIONS_PER_IP=20

# How long (ms) to hold messages for offline users. Default: 7 days
OFFLINE_MESSAGE_TTL_MS=604800000
